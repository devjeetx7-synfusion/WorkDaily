    <string name="htu_calendar_desc">कैलेंडर खोलकर किसी भी तारीख का हिसाब देखें और जरूरत पड़ने पर बदलाव करें।</string>

    <string name="htu_passbook_title">5. पासबुक</string>

    <string name="htu_passbook_desc">अपनी रोज की कमाई, एडवांस और नोट्स का पूरा बहीखाता देखें।</string>

    <string name="htu_all_time_passbook_title">6. ऑल टाइम पासबुक</string>

