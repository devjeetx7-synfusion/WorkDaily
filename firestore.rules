rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // WorkDaily Private Online User Account Collection
    // Path: `users/{firebaseUid}`
    // Strictly private: Other users CANNOT read email, phone number, workspace IDs, or account metadata.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.localWorkspaceId is string
                    && request.resource.data.localWorkspaceId.size() > 0;

      allow update: if isOwner(userId)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.localWorkspaceId == resource.data.localWorkspaceId
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // WorkDaily Public User Profiles
    // Path: `public_profiles/{firebaseUid}`
    // Strictly public identity fields only. Zero financial, attendance, or private contact data.
    match /public_profiles/{userId} {
      // Authenticated users may view public profiles or own profile
      allow get: if isAuthenticated() && (resource == null || resource.data.isPublic == true || isOwner(userId));

      // Authenticated users may search public profiles
      allow list: if isAuthenticated();

      // Create initial public profile (owner only)
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.usernameLower is string
                    && request.resource.data.usernameLower.size() >= 3
                    && request.resource.data.usernameLower.size() <= 20
                    && (request.resource.data.isVerified == false || !("isVerified" in request.resource.data));

      // Update public profile: owner can update profile fields, or authenticated users can update follower/following counts
      allow update: if isAuthenticated()
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (isOwner(userId) || (
                        request.resource.data.displayName == resource.data.displayName
                        && request.resource.data.username == resource.data.username
                        && request.resource.data.usernameLower == resource.data.usernameLower
                        && request.resource.data.displayNameLower == resource.data.displayNameLower
                        && request.resource.data.bio == resource.data.bio
                        && request.resource.data.profession == resource.data.profession
                        && request.resource.data.photoUrl == resource.data.photoUrl
                        && request.resource.data.isPublic == resource.data.isPublic
                        && request.resource.data.isVerified == resource.data.isVerified
                    ));

      allow delete: if false;
    }

    // WorkDaily Unique Username Reservation Registry
    // Path: `usernames/{normalizedUsername}`
    // Document ID is the lowercased, normalized username (e.g., `rahul_builder`).
    match /usernames/{username} {
      // Authenticated users can check availability by direct document lookup
      allow get: if isAuthenticated();
      allow list: if false;

      // Reserve username: owner claiming for themselves
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;

      // Updating reservation directly is forbidden
      allow update: if false;

      // Release username: owner deleting their own reservation during username change
      allow delete: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
    }

    // WorkDaily Follow Relationships Collection
    // Path: `follows/{followerUid}_${targetUid}`
    match /follows/{followId} {
      // Authenticated users can read follow records and query followers/following
      allow get, list: if isAuthenticated();

      // Create follow relationship (follower owner only, no self-follow)
      allow create: if isAuthenticated()
                    && request.resource.data.followerUid == request.auth.uid
                    && request.resource.data.followerUid != request.resource.data.targetUid;

      // Updating follow relationship directly is forbidden
      allow update: if false;

      // Delete follow relationship (follower owner only)
      allow delete: if isAuthenticated()
                    && resource.data.followerUid == request.auth.uid;
    }

    // Deny access to any other unmapped collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
