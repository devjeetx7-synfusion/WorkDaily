rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMutualFollower(userA, userB) {
      return exists(/databases/$(database)/documents/follows/$(userA + "_" + userB))
          && exists(/databases/$(database)/documents/follows/$(userB + "_" + userA));
    }

    function isNotBlocked(userA, userB) {
      return !exists(/databases/$(database)/documents/blocks/$(userA + "_" + userB))
          && !exists(/databases/$(database)/documents/blocks/$(userB + "_" + userA));
    }

    // WorkDaily Private Online User Account Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.localWorkspaceId is string
                    && request.resource.data.localWorkspaceId.size() > 0;

      allow update: if isOwner(userId)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.localWorkspaceId == resource.data.localWorkspaceId
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // WorkDaily Public User Profiles
    match /public_profiles/{userId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.isPublic == true || isOwner(userId));
      allow list: if isAuthenticated();

      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.usernameLower is string
                    && request.resource.data.usernameLower.size() >= 3
                    && request.resource.data.usernameLower.size() <= 20
                    && (request.resource.data.isVerified == false || !("isVerified" in request.resource.data));

      allow update: if isAuthenticated()
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (isOwner(userId) || (
                        request.resource.data.displayName == resource.data.displayName
                        && request.resource.data.username == resource.data.username
                        && request.resource.data.usernameLower == resource.data.usernameLower
                        && request.resource.data.displayNameLower == resource.data.displayNameLower
                        && request.resource.data.bio == resource.data.bio
                        && request.resource.data.profession == resource.data.profession
                        && request.resource.data.photoUrl == resource.data.photoUrl
                        && request.resource.data.isPublic == resource.data.isPublic
                        && request.resource.data.isVerified == resource.data.isVerified
                    ));

      allow delete: if false;
    }

    // WorkDaily Unique Username Reservation Registry
    match /usernames/{username} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;

      allow update: if false;

      allow delete: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
    }

    // WorkDaily Follow Relationships Collection
    match /follows/{followId} {
      allow get, list: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.followerUid == request.auth.uid
                    && request.resource.data.followerUid != request.resource.data.targetUid
                    && followId == request.resource.data.followerUid + "_" + request.resource.data.targetUid
                    && isNotBlocked(request.auth.uid, request.resource.data.targetUid);

      allow update: if false;

      // Follower can unfollow OR target user can remove follower
      allow delete: if isAuthenticated()
                    && (resource.data.followerUid == request.auth.uid || resource.data.targetUid == request.auth.uid);
    }

    // WorkDaily Block Collection
    match /blocks/{blockId} {
      allow get: if isAuthenticated()
                 && (resource == null
                     || resource.data.blockerUid == request.auth.uid
                     || resource.data.blockedUid == request.auth.uid);

      allow list: if isAuthenticated()
                  && resource.data.blockerUid == request.auth.uid;

      allow create: if isAuthenticated()
                    && request.resource.data.blockerUid == request.auth.uid
                    && request.resource.data.blockerUid != request.resource.data.blockedUid
                    && blockId == request.resource.data.blockerUid + "_" + request.resource.data.blockedUid;

      allow update: if false;

      allow delete: if isAuthenticated()
                    && resource.data.blockerUid == request.auth.uid;
    }

    // WorkDaily Reports Collection
    match /reports/{reportId} {
      allow read: if false;

      allow create: if isAuthenticated()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.reporterUid != request.resource.data.targetUid;

      allow update, delete: if false;
    }

    // WorkDaily Friends-Only Conversations & Messages
    match /conversations/{conversationId} {
      allow read: if isAuthenticated()
                  && (resource == null || request.auth.uid in resource.data.participants);

      allow create, update: if isAuthenticated()
                            && request.auth.uid in request.resource.data.participants
                            && isMutualFollower(request.resource.data.participants[0], request.resource.data.participants[1])
                            && isNotBlocked(request.resource.data.participants[0], request.resource.data.participants[1]);

      match /messages/{messageId} {
        allow read: if isAuthenticated()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if isAuthenticated()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && isMutualFollower(
                          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
                          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]
                      )
                      && isNotBlocked(
                          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
                          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]
                      );

        allow update: if isAuthenticated()
                      && request.auth.uid == resource.data.recipientUid
                      && request.resource.data.senderUid == resource.data.senderUid
                      && request.resource.data.recipientUid == resource.data.recipientUid
                      && request.resource.data.text == resource.data.text;

        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------------------------
    // WorkDaily Live Rooms + Watch Party
    //
    // live_rooms/{roomId}                               room document (host owned)
    // live_rooms/{roomId}/members/{uid}                 presence/membership (uid-keyed)
    // live_rooms/{roomId}/watch_party/state             shared playback state (host only)
    // live_rooms/{roomId}/watch_party_playlist/{itemId} playlist items (host only)
    // live_rooms/{roomId}/messages/{clientMessageId}    persistent chat (members only)
    // ---------------------------------------------------------------------------------------

    function liveRoom(roomId) {
      return get(/databases/$(database)/documents/live_rooms/$(roomId)).data;
    }

    function isLiveRoomHost(roomId) {
      return isAuthenticated() && liveRoom(roomId).hostUserId == request.auth.uid;
    }

    function isRoomLive(roomId) {
      return liveRoom(roomId).isLive == true && liveRoom(roomId).endedAtMillis == null;
    }

    // Membership cannot be forged: the document id must be the authenticated uid.
    function roomMember(roomId, uid) {
      return exists(/databases/$(database)/documents/live_rooms/$(roomId)/members/$(uid));
    }

    // Private rooms have no trusted invitation mechanism yet. Only their host may join.
    // A prior membership must not grant continued access after a block or visibility change.
    function canAccessLiveRoom(roomId) {
      return isAuthenticated() && (isLiveRoomHost(roomId) ||
          (liveRoom(roomId).isPublic == true && isNotBlocked(request.auth.uid, liveRoom(roomId).hostUserId)));
    }

    function isRoomMember(roomId) {
      return canAccessLiveRoom(roomId) && roomMember(roomId, request.auth.uid);
    }

    function isRoomMemberAfter(roomId) {
      return canAccessLiveRoom(roomId) && existsAfter(/databases/$(database)/documents/live_rooms/$(roomId)/members/$(request.auth.uid));
    }

    match /live_rooms/{roomId} {
      allow get, list: if isAuthenticated();

      // A room can only be created by the authenticated account that claims to host it.
      allow create: if isAuthenticated()
                    && request.resource.data.hostUserId == request.auth.uid
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.get('mediaManaged', false) == false
                    && request.resource.data.type in ["TEXT", "YOUTUBE_WATCH_PARTY"]
                    && request.resource.data.get('endedAtMillis', null) == null
                    && request.resource.data.isLive == true;

      // Only the persisted host can update the room document (settings, end the room).
      // hostUserId/creatorId are immutable so a room cannot be hijacked.
      allow update: if isAuthenticated()
                    && resource.data.hostUserId == request.auth.uid
                    && resource.data.get('mediaManaged', false) == false
                    && request.resource.data.get('mediaManaged', false) == false
                    && request.resource.data.hostUserId == resource.data.hostUserId
                    && request.resource.data.creatorId == resource.data.creatorId
                    && request.resource.data.type == resource.data.type
                    && (resource.data.get('endedAtMillis', null) == null ||
                        (request.resource.data.get('endedAtMillis', null) != null && request.resource.data.isLive == false));

      allow delete: if isAuthenticated()
                    && resource.data.hostUserId == request.auth.uid
                    && resource.data.get('mediaManaged', false) == false;

      // Presence / membership. Document id == authenticated uid, so it cannot be forged and
      // reconnecting can never create a duplicate row.
      match /members/{memberUid} {
        // The join transaction reads its own (possibly nonexistent) membership before writing it.
        allow get: if isRoomMember(roomId) || isLiveRoomHost(roomId) ||
                      (isAuthenticated() && memberUid == request.auth.uid && canAccessLiveRoom(roomId) && isRoomLive(roomId));
        allow list: if isRoomMember(roomId) || isLiveRoomHost(roomId);

        // Role is pinned: only the persisted host may hold the HOST role, so a member cannot
        // promote themselves (which would hide them from the viewer count or show a host badge).
        allow create, update: if isAuthenticated()
                              && memberUid == request.auth.uid
                              && request.resource.data.uid == request.auth.uid
                              && (request.resource.data.role == "VIEWER" || isLiveRoomHost(roomId))
                              && canAccessLiveRoom(roomId)
                              && isRoomLive(roomId);

        // A member leaves on their own; the host may remove a participant.
        allow delete: if isAuthenticated()
                      && (memberUid == request.auth.uid || isLiveRoomHost(roomId));
      }

      // Shared playback state: read by every member, written only by the host of a live room.
      match /watch_party/state {
        allow get, list: if isRoomMember(roomId) || isLiveRoomHost(roomId);

        allow create, update: if isAuthenticated()
                              && isLiveRoomHost(roomId)
                              && isRoomLive(roomId)
                              && request.resource.data.hostUserId == request.auth.uid
                              && request.resource.data.revision is int
                              && request.resource.data.revision > 0;

        allow delete: if false;
      }

      // Playlist queue: host only writes, members read.
      // (Its own collection: a Firestore path alternates collection/document, so the queue cannot
      // be a sibling subcollection of the `state` document under `watch_party`.)
      match /watch_party_playlist/{itemId} {
        allow get, list: if isRoomMember(roomId) || isLiveRoomHost(roomId);

        allow create: if isAuthenticated()
                      && isLiveRoomHost(roomId)
                      && isRoomLive(roomId)
                      && request.resource.data.addedByUserId == request.auth.uid
                      && request.resource.data.videoId is string
                      && request.resource.data.videoId.size() == 11;

        allow update: if false;

        allow delete: if isAuthenticated() && isLiveRoomHost(roomId);
      }

      // Persistent room chat: members only, sender identity pinned to the auth uid, and the
      // message document id is the client message id (idempotent retries, no duplicates).
      match /messages/{messageId} {
        // The join transaction checks only the caller's deterministic join event.
        allow get: if isRoomMember(roomId) || (canAccessLiveRoom(roomId) && isRoomLive(roomId) &&
                      messageId == "sys_join_" + roomId + "_" + request.auth.uid);
        allow list: if isRoomMember(roomId);

        allow create: if isAuthenticated()
                      && isRoomLive(roomId)
                      && isRoomMemberAfter(roomId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.roomId == roomId
                      && request.resource.data.clientMessageId == messageId
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      && request.resource.data.message.size() <= 500
                      && request.resource.data.timestamp == request.time;

        allow update, delete: if false;
      }
    }

    // Deny access to any other unmapped collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
